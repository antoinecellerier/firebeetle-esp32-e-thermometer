	(footprint "local:XUNPU_FPC-05FB-24PH20"
		(layer "F.Cu")
		(uuid "c1d42765-8513-5b92-bf7a-b12f27c272ce")
		(at 143.075 116.8 90)
		(descr "XUNPU FPC-05FB-24PH20, 24-pin 0.5mm FPC, H2.0 rear-flip, dual (top+bottom) contact, LCSC C2856831. SMT contact tails / pad row are at the REAR (actuator) face; the mouth / cable entry is on the FAR side (+y local), 6.55mm from the pad centers (numeric STEP proof + datasheets/XUNPU_FPC-05FB-NPH20.pdf, 2026-07-19: feet 0.5mm inside the rear wall, mouth slot lips 6.55mm away). Land per the XUNPU drawing: pads 0.3x1.2 @0.5mm at y-1.625, anchor tabs 2.0x1.8 at +/-7.3/+1.625. Pads are numbered so pad 1 = panel circuit 1 and sits NORTH when placed rot 90 (contact tails WEST, mouth EAST toward the board edge; matches DESPI-C02 P1 mating orientation).")
		(tags "FPC FFC XUNPU 24 0.5mm dual-contact")
		(property "Reference" "J4"
			(at 0 -3.2 90)
			(layer "F.Fab")
			(uuid "bb0e2ded-62e2-5fb9-adcf-030e9e6e40d7")
			(effects
