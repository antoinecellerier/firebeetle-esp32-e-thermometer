(version 1)
# generated by generator/pcb.py - do not edit
(rule hv-clearance
  (condition "A.NetName == 'EPD_PREVGH' || A.NetName == 'EPD_PREVGL' || A.NetName == 'Net-(J4-Pin_5)' || A.NetName == 'Net-(J4-Pin_4)' || A.NetName == 'Net-(J4-Pin_20)' || A.NetName == 'Net-(J4-Pin_22)' || A.NetName == 'Net-(J4-Pin_24)' || A.NetName == 'Net-(J4-Pin_19)'")
  (constraint clearance (min 0.3mm)))
(rule hv-clearance-fanout
  (condition "(A.NetName == 'EPD_PREVGH' || A.NetName == 'EPD_PREVGL' || A.NetName == 'Net-(J4-Pin_5)' || A.NetName == 'Net-(J4-Pin_4)' || A.NetName == 'Net-(J4-Pin_20)' || A.NetName == 'Net-(J4-Pin_22)' || A.NetName == 'Net-(J4-Pin_24)' || A.NetName == 'Net-(J4-Pin_19)') && A.insideArea('fpc-fanout')")
  (constraint clearance (min 0.18mm)))
(rule hv-clearance-j4
  (condition "A.memberOfFootprint('J4') && B.memberOfFootprint('J4')")
  (constraint clearance (min 0.18mm)))
(rule edge-clearance-usb-c
  (condition "A.memberOfFootprint('J3')")
  (constraint edge_clearance (min 0mm)))
(rule hole-to-hole-samenet
  (condition "A.NetName == B.NetName")
  (constraint hole_to_hole (min 0.25mm)))
(rule power-track-width
  (condition "A.NetName == 'VBAT' || A.NetName == 'VSYS' || A.NetName == 'EPD_VCC' || A.NetName == 'Net-(J2-Pin_1)' || A.NetName == 'Net-(J1-Pin_1)'")
  (constraint track_width (min 0.5mm)))
(rule power-track-width-fanout
  (condition "A.NetName == 'EPD_VCC' && A.insideArea('fpc-fanout')")
  (constraint track_width (min 0.25mm)))
(rule silk-merge
  (condition "A.insideArea('silk-merge')")
  (constraint silk_clearance (min -0.3mm)))
