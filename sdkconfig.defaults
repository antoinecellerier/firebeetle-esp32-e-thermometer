# Authored defaults for the pure-ESP-IDF build (both boards).
# Target-specific settings live in sdkconfig.defaults.<target>.

CONFIG_FREERTOS_HZ=1000

# app_main's task runs everything including display rendering;
# IDF default (3584) would overflow
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# No OTA — repo-owned table with a maximal app slot (see partitions.csv).
# NOTE: PlatformIO ignores sdkconfig partition selection and generates the
# table from board_build.partitions; both point at the same file.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# -Os instead of the IDF-default -Og (which even "release" builds used —
# PlatformIO build_type does not set IDF's optimization level). The post-
# skip-validate wake active phase is CPU-bound; -Os also shrinks the image.
# Applies to debug builds too (they're for serial logs, not JTAG stepping).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Skip the app image SHA256 re-verification on deep-sleep wakes: with a ~1MB
# image on DIO/40MHz flash the bootloader spent hundreds of ms re-hashing it on
# every wake (100% of wakes, including no-refresh safety-net wakes). Power-on
# and reset boots still validate. Uses the bootloader RTC-FAST retain area —
# no conflict with the ULP/RTC_DATA_ATTR layout in RTC slow memory.
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y

# NTP: primary + fallback server (esp_netif_sntp)
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# WiFi DPP (QR-code onboarding, shelved feature — was sdkconfig.custom)
CONFIG_ESP_WIFI_DPP_SUPPORT=y

# IDF 6: pin newlib. PlatformIO's ulp.py doesn't forward ADD_PICOLIBC_SPECS
# to the LP-core sub-build (unlike IDF's own ulp_embed_binary), so the default
# picolibc breaks the C6 LP-core compile (_REENT/_mbstate_t). Newlib matches
# the IDF 5.5 behavior we validated. Revisit picolibc (~20% smaller binaries)
# when PlatformIO passes the flag through, or when building with idf.py only.
CONFIG_LIBC_NEWLIB=y
