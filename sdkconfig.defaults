# Authored defaults for the pure-ESP-IDF build (both boards).
# Target-specific settings live in sdkconfig.defaults.<target>.

CONFIG_FREERTOS_HZ=1000

# CPU fixed at 80MHz on both boards (project-wide invariant — wake path is
# flash-bound, higher clocks measured no better; see docs/notes.md).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

# Both boards run a ULP coprocessor for temperature polling during deep
# sleep; the type (FSM vs LP core) and RESERVE_MEM are per-target.
CONFIG_ULP_COPROC_ENABLED=y

# app_main's task runs everything including display rendering;
# IDF default (3584) would overflow
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# No OTA — repo-owned table with a maximal app slot (see partitions.csv).
# NOTE: PlatformIO ignores sdkconfig partition selection and generates the
# table from board_build.partitions; both point at the same file.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# -Os instead of the IDF-default -Og (which even "release" builds used —
# PlatformIO build_type does not set IDF's optimization level). The post-
# skip-validate wake active phase is CPU-bound; -Os also shrinks the image.
# Applies to debug builds too (they're for serial logs, not JTAG stepping).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Skip the app image SHA256 re-verification on deep-sleep wakes: with a ~1MB
# image on DIO/40MHz flash the bootloader spent hundreds of ms re-hashing it on
# every wake (100% of wakes, including no-refresh safety-net wakes). Power-on
# and reset boots still validate. Uses the bootloader RTC-FAST retain area —
# no conflict with the ULP/RTC_DATA_ATTR layout in RTC slow memory.
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y

# NTP: primary + fallback server (esp_netif_sntp)
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# Bind the DHCP-offered address without ARP-probing it first. Measured -1.08s on
# every connect (DHCP 3920 -> 2841ms mean, board 2 2026-08-09); IDF's own Kconfig
# documents the probe as costing 1-2s, and DHCP is ~90% of a 4s connect here.
#
# This is a deliberate RFC 2131 deviation (a client SHOULD probe), so the failure
# it gives up on is worth naming: an address already in use by someone the DHCP
# server doesn't know about — a static IP inside the pool, or a second DHCP
# server on the same L2. DHCPNAK still covers server-side disagreement, and we
# never enter the address-reuse path (CONFIG_LWIP_DHCP_RESTORE_LAST_IP stays off,
# measured worthless and unsafe for a device whose lease is always long expired),
# so the exposure is only what the server itself has wrong.
#
# Consequence to remember: a conflict presents as a healthy association whose
# SNTP fails, i.e. a persistent "! NOSYNC" indistinguishable from a dead AP.
# Suspect an IP conflict before the radio. See docs/notes.md.
CONFIG_LWIP_DHCP_DOES_NOT_CHECK_OFFERED_IP=y

# WiFi DPP (QR-code onboarding, shelved feature — was sdkconfig.custom)
CONFIG_ESP_WIFI_DPP_SUPPORT=y

# IDF 6: pin newlib. PlatformIO's ulp.py doesn't forward ADD_PICOLIBC_SPECS
# to the LP-core sub-build (unlike IDF's own ulp_embed_binary), so the default
# picolibc breaks the C6 LP-core compile (_REENT/_mbstate_t). Newlib matches
# the IDF 5.5 behavior we validated. Revisit picolibc (~20% smaller binaries)
# when PlatformIO passes the flag through, or when building with idf.py only.
CONFIG_LIBC_NEWLIB=y

# Crash forensics: on panic, dump core to the 64KB "coredump" partition
# (already in partitions.csv); the next boot renders task/PC on screen and
# erases the dump (see harvest_coredump_summary). Task-WDT escalates to panic
# so hangs leave a dump too instead of just logging to a console nobody reads.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_TASK_WDT_PANIC=y
